# ── WeathCionz environment ────────────────────────────────────────────────
# Copy this file to `.env` and fill in your API keys.

# Get a free key at https://app.tomorrow.io/development/keys
VITE_TOMORROW_KEY=your_tomorrow_io_api_key_here

# OpenWeatherMap is still used for map tiles and geocoding.
# Get a free key at https://openweathermap.org/api
VITE_OWM_KEY=your_openweathermap_api_key_here

# Optional — a backend proxy (e.g. the included Vercel function in /api).
# Set to your deployed URL to keep the key server-side in production, e.g.
#   VITE_API_BASE=https://your-project.vercel.app/api
# Leave blank to call OpenWeatherMap directly (development only).
VITE_API_BASE=
